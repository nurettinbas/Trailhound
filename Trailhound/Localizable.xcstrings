    "label.median_speed.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Median is the middle speed of this trip’s moving time: half the drive was slower, half was faster. It is less skewed by short spikes than the average."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medyan, hareket halindeki sürenin orta hızıdır: sürüşün yarısı daha yavaş, yarısı daha hızlıdır. Ortalamaya göre kısa ani sıçramalardan daha az etkilenir."
          }
        }
      }
    },
