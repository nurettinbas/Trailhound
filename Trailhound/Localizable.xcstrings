      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common speed is the speed band you spent the most time in while driving (about ±2.5 km/h). Slow crawl or queue time is left out so it reflects your real pace."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En sık hız, sürerken en çok zaman geçirdiğin hız aralığıdır (yaklaşık ±2.5 km/s). Yavaş sürünme / kuyruk süresi sayılmaz; gerçek tempoyu yansıtır."
          }
        }
      }
