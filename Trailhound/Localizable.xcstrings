        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated looks at this trip’s speeds, stops, and how hard you accelerated — not just distance times your average. Idle time counts too. It’s an estimate, not the pump."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahmini, sadece mesafe × ortalama değil; bu yolculuktaki hız, duruş ve hızlanmaya bakar. Rölanti de dahildir. Pompa değil, tahmindir."
          }
        }
      }
