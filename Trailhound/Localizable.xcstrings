    "pairing.shortcuts.guide.connect.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Shortcuts and stay on the Shortcuts tab (not Automation yet)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısayollar'ı aç ve Kısayollar sekmesinde kal (henüz Otomasyon değil)."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + → New Shortcut. Name it clearly (e.g. Start Vespa or Start car)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+ → Yeni Kısayol. Anlaşılır bir ad ver (ör. Vespa Başlat veya Araba Başlat)."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Action → search Trailhound → Start trip. Tap the blue Vehicle and pick that vehicle, then save the Shortcut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylem Ekle → Trailhound ara → Yolculuğu başlat. Mavi Araç alanına dokunup aracı seç, Kısayolu kaydet."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to the Automation tab → + → Personal Automation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomasyon sekmesine git → + → Kişisel Otomasyon."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a trigger — Bluetooth (device → Is Connected), CarPlay (Is Connected), or Wi‑Fi (When Joined)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetikleyici seç — Bluetooth (aygıt → Bağlandığında), CarPlay (Bağlandığında) veya Wi‑Fi (Ağa Katıldığında)."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step6" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Action → search Run Shortcut → pick the Shortcut you just made (do not add Trailhound Start trip here)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eylem Ekle → Kısayol Çalıştır ara → az önce yaptığın Kısayolu seç (buraya Trailhound Yolculuğu başlat ekleme)."
          }
        }
      }
    },
    "pairing.shortcuts.guide.connect.step7" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off Ask Before Running (and Notify When Run if shown), then save. For another vehicle, repeat with a second Shortcut + automation."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştırmadan Önce Sor'u kapat (Çalışınca Bildir varsa onu da), kaydet. Başka araç için ikinci bir Kısayol + otomasyon tekrarla."
          }
        }
      }
    },
