    "label.cruise_speed.help.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruise is your average speed while the car was moving — stop time is left out. That is why it is usually higher than overall average speed when you waited at lights or in traffic."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seyir hızı, araç hareket halindeyken ortalama hızındır — durma süresi sayılmaz. Işıkta veya trafikte beklediysen genel ortalamadan genelde daha yüksektir."
          }
        }
      }
    },
