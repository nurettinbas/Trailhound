    "pairing.shortcuts.guide.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS Shortcuts can start and stop recording when your phone connects to the car — over Bluetooth, CarPlay, or Wi‑Fi. Pick the vehicle in a named Shortcut first; Personal Automations often hide that picker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS Kısayollar, telefon araca Bluetooth, CarPlay veya Wi‑Fi ile bağlanınca kaydı başlatıp kopunca durdurabilir. Aracı önce isimli bir Kısayol’da seç — Kişisel Otomasyon’da araç seçici çoğu zaman görünmez."
          }
        }
      }
    },
    "pairing.shortcuts.guide.next" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleri"
          }
        }
      }
    },
    "pairing.shortcuts.guide.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Personal Automations often hide the Vehicle picker on Start trip — that is why we bind the vehicle in a named Shortcut, then Run Shortcut from the automation. Wireless CarPlay users sometimes mix triggers (CarPlay to start, Bluetooth to end)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İpucu: Kişisel Otomasyon’da Yolculuğu başlat’ta Araç seçici çoğu zaman görünmez — bu yüzden aracı isimli Kısayol’da sabitleyip otomasyonda Kısayol Çalıştır kullanıyoruz. Kablosuz CarPlay’de tetikleyiciler karışabilir (başlat: CarPlay, bitir: Bluetooth)."
          }
        }
      }
    },
    "pairing.shortcuts.guide.open_shortcuts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
