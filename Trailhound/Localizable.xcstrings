    "pairing.shortcuts.guide.handoff.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a named Start Shortcut (with Vehicle), then a Personal Automation that runs it — and an End trip automation. Come back here when you’re done."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
