      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P90 is the upper pace of this trip’s moving time: you were slower than this for 90% of the drive. It shows how fast you typically go at the high end, without being skewed by a single max spike."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "P90, hareket halindeki sürenin üst temposudur: sürüşün %90’ında bundan yavaştın. En yüksek ucu gösterir; tek bir ani max sıçramasından medyana göre daha az, max’tan daha az etkilenir."
          }
        }
      }
    },
