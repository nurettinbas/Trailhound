    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo of your vehicle for its avatar, or of a receipt to attach to an expense."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç avatarı için aracını ya da bir gidere eklemek için fişi fotoğrafla."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to protect your trip history."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yolculuk geçmişinizi korumak için Face ID kullanılır."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records your route when the screen is off or a Shortcut starts a trip. Location stays on this iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kapalıyken veya bir Kestirme yolculuk başlattığında rotanı kaydeder. Konum bu iPhone’dan çıkmaz."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records the route of the trip you start in Trailhound. Location stays on this iPhone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trailhound’da başlattığın yolculuğun rotasını kaydeder. Konum bu iPhone’dan çıkmaz."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a recent photo for your vehicle avatar or an expense receipt. If you decline, you can still pick one photo at a time."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç avatarı veya gider fişi için son fotoğraflarından birini seçmen için. İzin vermezsen yine tek tek fotoğraf seçebilirsin."
          }
        }
      }
    }
  },
  "version" : "1.0"
